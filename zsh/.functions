# ============================================
# Kubernetes/OpenShift Utilities
# ============================================

# Switch between kubeconfig files interactively (works even if ls is aliased)
# Security: Uses local variables to prevent credential leakage
kcswitch() {
  local kube_dir="$HOME/.kube"
  local files=("$kube_dir"/*.kubeconfig "$kube_dir/config")

  echo ""
  echo "Available kubeconfig files:"
  local i=1
  for f in "${files[@]}"; do
    if [ -f "$f" ]; then
      echo "  [$i] $(basename "$f")"
      ((i++))
    fi
  done

  echo -n "\nEnter number to select kubeconfig: "
  local choice
  read choice

  # numeric check (works in zsh & bash)
  case "$choice" in
    ''|*[!0-9]*) echo "❌ Invalid input. Please enter a number."; return 1;;
  esac

  local index=1 selected=""
  for f in "${files[@]}"; do
    if [ -f "$f" ]; then
      if [ "$index" -eq "$choice" ]; then
        selected="$f"
        export KUBECONFIG="$selected"
        echo "✅ Switched to $(basename "$selected")"
        break
      fi
      ((index++))
    fi
  done

  [ -z "$selected" ] && echo "❌ Invalid selection. No kubeconfig switched." && return 1

  # Identify environment and login accordingly
  case "$(basename "$selected")" in
    *nonprod*) echo "🌐 Detected NONPROD environment"; ocnonprod;;
    *prod*) echo "🌐 Detected PROD environment"; ocprod;;
    *) echo "ℹ️ No matching login alias found for $(basename "$selected")";;
  esac
}

# ============================================
# OpenShift/ROSA Credential Management
# ============================================
#
# SECURITY NOTES:
# - Credentials are retrieved from KeePassXC (never stored in plain text)
# - Passwords are explicitly cleared from memory after use (unset)
# - stdin is redirected to /dev/null to prevent password exposure in terminal
# - All error messages are sent to stderr for proper logging
# - Session caching: First KeePassXC call prompts for password, subsequent calls are cached
#
# Usage: ocprod (for production) or ocnonprod (for development)
# These functions auto-detect environment and login when switching kubeconfigs

# Secure OpenShift login functions using KeePassXC entries
ocprod() {
    echo "🔐 Retrieving ROSA Console Prod credentials from KeePassXC..."
    echo "Please enter your KeePassXC master password when prompted."

    local keepass_db=~/Keepass/Abhinav/Sentry.kdbx
    local entry_name='ROSA Console Prod'

    # Check if KeePassXC CLI exists (always use direct path to avoid alias issues)
    local keepassxc_cli_cmd
    if [ -f "/Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli" ]; then
        keepassxc_cli_cmd="/Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli"
    elif command -v keepassxc-cli &>/dev/null && ! alias keepassxc-cli &>/dev/null; then
        # Only use this if it's a real command, not an alias
        keepassxc_cli_cmd="keepassxc-cli"
    else
        echo "❌ keepassxc-cli not found. Please install KeePassXC."
        return 1
    fi

    # Check if database exists
    if [ ! -f "$keepass_db" ]; then
        echo "❌ KeePassXC database not found at: $keepass_db"
        return 1
    fi

    # Get both username and password in a single call to reduce password prompts
    echo "📋 Retrieving username from KeePassXC..."
    local username password
    username="$($keepassxc_cli_cmd show -a UserName "$keepass_db" "$entry_name")"
    local user_status=$?
    if [ $user_status -ne 0 ] || [ -z "$username" ]; then
        echo "❌ Failed to retrieve username from KeePassXC (exit code: $user_status)"
        echo "Debug: Tried to retrieve from entry '$entry_name' in database '$keepass_db'"
        return 1
    fi

    echo "🔑 Retrieving password from KeePassXC..."
    password="$($keepassxc_cli_cmd show -a Password "$keepass_db" "$entry_name")"
    local pass_status=$?
    if [ $pass_status -ne 0 ] || [ -z "$password" ]; then
        echo "❌ Failed to retrieve password from KeePassXC (exit code: $pass_status)"
        return 1
    fi

    echo "🚀 Logging into ROSA Prod environment..."
    # Use --insecure-skip-tls-verify only if certificate validation fails
    oc login https://api.carey-prod.zdk3.p1.openshiftapps.com:6443 \
        --username="$username" \
        --password="$password" \
        </dev/null
    local login_status=$?

    # Clear password from memory (security best practice)
    unset password

    if [ $login_status -ne 0 ]; then
        echo "❌ Failed to login to ROSA Prod. Check your credentials and network connectivity."
        return $login_status
    fi
}

# Secure OpenShift login for non-production environment
ocnonprod() {
    echo "🔐 Retrieving ROSA Console Dev credentials from KeePassXC..."
    echo "Please enter your KeePassXC master password when prompted."

    local keepass_db=~/Keepass/Abhinav/Sentry.kdbx
    local entry_name='ROSA Console Dev'

    # Check if KeePassXC CLI exists (always use direct path to avoid alias issues)
    local keepassxc_cli_cmd
    if [ -f "/Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli" ]; then
        keepassxc_cli_cmd="/Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli"
    elif command -v keepassxc-cli &>/dev/null && ! alias keepassxc-cli &>/dev/null; then
        # Only use this if it's a real command, not an alias
        keepassxc_cli_cmd="keepassxc-cli"
    else
        echo "❌ keepassxc-cli not found. Please install KeePassXC."
        return 1
    fi

    # Check if database exists
    if [ ! -f "$keepass_db" ]; then
        echo "❌ KeePassXC database not found at: $keepass_db"
        return 1
    fi

    # Get both username and password in a single call to reduce password prompts
    echo "📋 Retrieving username from KeePassXC..."
    local username password
    username="$($keepassxc_cli_cmd show -a UserName "$keepass_db" "$entry_name")"
    local user_status=$?
    if [ $user_status -ne 0 ] || [ -z "$username" ]; then
        echo "❌ Failed to retrieve username from KeePassXC (exit code: $user_status)"
        echo "Debug: Tried to retrieve from entry '$entry_name' in database '$keepass_db'"
        return 1
    fi

    echo "🔑 Retrieving password from KeePassXC..."
    password="$($keepassxc_cli_cmd show -a Password "$keepass_db" "$entry_name")"
    local pass_status=$?
    if [ $pass_status -ne 0 ] || [ -z "$password" ]; then
        echo "❌ Failed to retrieve password from KeePassXC (exit code: $pass_status)"
        return 1
    fi

    echo "🚀 Logging into ROSA Dev environment..."
    # Use --insecure-skip-tls-verify only if certificate validation fails
    oc login https://api.carey-nonprod.kq6p.p1.openshiftapps.com:6443 \
        --username="$username" \
        --password="$password" \
        </dev/null
    local login_status=$?

    # Clear password from memory (security best practice)
    unset password

    if [ $login_status -ne 0 ]; then
        echo "❌ Failed to login to ROSA Dev. Check your credentials and network connectivity."
        return $login_status
    fi
}


# List all Published SNAPSHOT versions for a Maven artifact in CodeArtifact
ca_snapshots() {
  local domain=$1
  local owner=$2
  local repo=$3
  local namespace=$4   # groupId
  local pkg=$5         # artifactId
  local profile=${6:-carey}

  if [[ -z "$domain" || -z "$owner" || -z "$repo" || -z "$namespace" || -z "$pkg" ]]; then
    echo "Usage: ca_snapshots <domain> <owner> <repo> <groupId> <artifactId> [profile]"
    return 1
  fi

  echo "🔍 Fetching Published SNAPSHOT versions for ${namespace}:${pkg} ..."
  aws codeartifact list-package-versions \
    --domain "$domain" \
    --domain-owner "$owner" \
    --repository "$repo" \
    --format maven \
    --namespace "$namespace" \
    --package "$pkg" \
    --profile "$profile" \
    --output json |
  jq -r '.versions
    | map(select(.version | contains("SNAPSHOT")) | select(.status=="Published"))
    | sort_by(.version)
    | .[] | "\(.version)\t\(.status)"'
}

# List available jar assets for a specific package version in CodeArtifact
ca_list_jars() {
  # Parse named arguments
  local domain="" repo="" namespace="" pkg="" version="" profile="carey"

  while [[ $# -gt 0 ]]; do
    case $1 in
      --help|-h)
        echo "ca_list_jars - List available jar assets for a specific package version in CodeArtifact"
        echo ""
        echo "Usage: ca_list_jars --domain=<domain> --repo=<repo> --namespace=<groupId> --package=<artifactId> --version=<version> [--profile=<profile>]"
        echo ""
        echo "Parameters:"
        echo "  --domain=<domain>        CodeArtifact domain name"
        echo "  --repo=<repo>           Repository name (e.g., maven-snapshots)"
        echo "  --namespace=<groupId>   Maven groupId (e.g., com.careylimo)"
        echo "  --package=<artifactId>  Maven artifactId (e.g., Res-Core)"
        echo "  --version=<version>     Package version (e.g., 1.3.4-SNAPSHOT)"
        echo "  --profile=<profile>     AWS profile to use (default: default)"
        echo ""
        echo "Example:"
        echo "  ca_list_jars --domain=carey --repo=maven-snapshots --namespace=com.careylimo --package=Res-Core --version=1.3.4-SNAPSHOT --profile=carey"
        echo ""
        echo "Note: AWS Account ID (domain owner) is automatically detected from the specified profile."
        return 0
        ;;
      --domain=*) domain="${1#*=}"; shift ;;
      --repo=*) repo="${1#*=}"; shift ;;
      --namespace=*) namespace="${1#*=}"; shift ;;
      --package=*) pkg="${1#*=}"; shift ;;
      --version=*) version="${1#*=}"; shift ;;
      --profile=*) profile="${1#*=}"; shift ;;
      *) echo "❌ Unknown parameter: $1"; return 1 ;;
    esac
  done

  if [[ -z "$domain" || -z "$repo" || -z "$namespace" || -z "$pkg" || -z "$version" ]]; then
    echo "Usage: ca_list_jars --domain=<domain> --repo=<repo> --namespace=<groupId> --package=<artifactId> --version=<version> [--profile=<profile>]"
    echo ""
    echo "Example:"
    echo "  ca_list_jars --domain=carey --repo=maven-snapshots --namespace=com.careylimo --package=Res-Core --version=1.3.4-SNAPSHOT --profile=carey"
    return 1
  fi

  # Auto-detect owner from profile
  echo "🔍 Auto-detecting owner from AWS profile '$profile'..."
  local owner=$(aws sts get-caller-identity --profile "$profile" --query 'Account' --output text 2>/dev/null)
  if [[ -z "$owner" || "$owner" == "None" ]]; then
    echo "❌ Failed to get AWS Account ID from profile '$profile'. Check your AWS credentials."
    return 1
  fi
  echo "✅ Using owner: $owner"

  echo "🔍 Listing jar assets for ${namespace}:${pkg}:${version} ..."
  aws codeartifact list-package-version-assets \
    --domain "$domain" \
    --domain-owner "$owner" \
    --repository "$repo" \
    --format maven \
    --namespace "$namespace" \
    --package "$pkg" \
    --package-version "$version" \
    --profile "$profile" \
    --query 'assets[?ends_with(name, `.jar`)].name' \
    --output table
}

# Download a jar from CodeArtifact Maven repository to Downloads folder
ca_download_jar() {
  # Parse named arguments
  local domain="" repo="" namespace="" pkg="" version="" asset_name="" profile="carey"

  while [[ $# -gt 0 ]]; do
    case $1 in
      --help|-h)
        echo "ca_download_jar - Download a jar from CodeArtifact Maven repository to Downloads folder"
        echo ""
        echo "Usage: ca_download_jar --domain=<domain> --repo=<repo> --namespace=<groupId> --package=<artifactId> --version=<version> [--asset=<jar_name>] [--profile=<profile>]"
        echo ""
        echo "Parameters:"
        echo "  --domain=<domain>        CodeArtifact domain name"
        echo "  --repo=<repo>           Repository name (e.g., maven-snapshots)"
        echo "  --namespace=<groupId>   Maven groupId (e.g., com.careylimo)"
        echo "  --package=<artifactId>  Maven artifactId (e.g., Res-Core)"
        echo "  --version=<version>     Package version (e.g., 1.3.4-SNAPSHOT)"
        echo "  --asset=<jar_name>      Specific jar asset name (optional - will list if not provided)"
        echo "  --profile=<profile>     AWS profile to use (default: default)"
        echo ""
        echo "Examples:"
        echo "  # List available jar assets first"
        echo "  ca_download_jar --domain=carey --repo=maven-snapshots --namespace=com.careylimo --package=Res-Core --version=1.3.4-SNAPSHOT --profile=carey"
        echo ""
        echo "  # Download specific jar asset"
        echo "  ca_download_jar --domain=carey --repo=maven-snapshots --namespace=com.careylimo --package=Res-Core --version=1.3.3.20251009-SNAPSHOT --asset=Res-Core-1.3.3.20251009-20251009.094201-1.jar --profile=carey"
        echo ""
        echo "Note: AWS Account ID (domain owner) is automatically detected from the specified profile."
        echo "      Downloaded jars are saved to ~/Downloads/<artifactId>.jar"
        return 0
        ;;
      --domain=*) domain="${1#*=}"; shift ;;
      --repo=*) repo="${1#*=}"; shift ;;
      --namespace=*) namespace="${1#*=}"; shift ;;
      --package=*) pkg="${1#*=}"; shift ;;
      --version=*) version="${1#*=}"; shift ;;
      --asset=*) asset_name="${1#*=}"; shift ;;
      --profile=*) profile="${1#*=}"; shift ;;
      *) echo "❌ Unknown parameter: $1"; return 1 ;;
    esac
  done

  if [[ -z "$domain" || -z "$repo" || -z "$namespace" || -z "$pkg" || -z "$version" ]]; then
    echo "Usage: ca_download_jar --domain=<domain> --repo=<repo> --namespace=<groupId> --package=<artifactId> --version=<version> [--asset=<jar_name>] [--profile=<profile>]"
    echo ""
    echo "Examples:"
    echo "  # List available jar assets first"
    echo "  ca_download_jar --domain=carey --repo=maven-snapshots --namespace=com.careylimo --package=Res-Core --version=1.3.4-SNAPSHOT --profile=carey"
    echo ""
    echo "  # Download specific jar asset"
    echo "  ca_download_jar --domain=carey --repo=maven-snapshots --namespace=com.careylimo --package=Res-Core --version=1.3.3.20251009-SNAPSHOT --asset=Res-Core-1.3.3.20251009-20251009.094201-1.jar --profile=carey"
    return 1
  fi

  # Auto-detect owner from profile
  echo "🔍 Auto-detecting owner from AWS profile '$profile'..."
  local owner=$(aws sts get-caller-identity --profile "$profile" --query 'Account' --output text 2>/dev/null)
  if [[ -z "$owner" || "$owner" == "None" ]]; then
    echo "❌ Failed to get AWS Account ID from profile '$profile'. Check your AWS credentials."
    return 1
  fi
  echo "✅ Using owner: $owner"

  # If asset name not provided, list available assets
  if [[ -z "$asset_name" ]]; then
    echo "ℹ️  No asset name provided. Listing available jar assets:"
    echo ""
    ca_list_jars --domain="$domain" --repo="$repo" --namespace="$namespace" --package="$pkg" --version="$version" --profile="$profile"
    echo ""
    echo "💡 Tip: Copy one of the jar names above and add --asset=<jar-name> to download"
    return 0
  fi

  # Ensure Downloads directory exists
  local downloads_dir="$HOME/Downloads"
  if [[ ! -d "$downloads_dir" ]]; then
    echo "📁 Creating Downloads directory..."
    mkdir -p "$downloads_dir"
  fi

  # Create output filename (remove version-specific timestamps for cleaner naming)
  local output_file="$downloads_dir/${pkg}.jar"

  echo "📥 Downloading ${asset_name} to ${output_file}..."
  echo "🔍 Source: ${namespace}:${pkg}:${version}"
  echo ""

  # Download the jar
  aws codeartifact get-package-version-asset \
    --domain "$domain" \
    --domain-owner "$owner" \
    --repository "$repo" \
    --format maven \
    --namespace "$namespace" \
    --package "$pkg" \
    --package-version "$version" \
    --asset "$asset_name" \
    --profile "$profile" \
    "$output_file"

  local download_status=$?

  if [[ $download_status -eq 0 ]]; then
    echo "✅ Successfully downloaded jar to: $output_file"
    echo "📊 File info:"
    ls -lh "$output_file"
  else
    echo "❌ Failed to download jar (exit code: $download_status)"
    return $download_status
  fi
}
