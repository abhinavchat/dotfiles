# ============================================
# Network Utilities
# ============================================

# Check if a port is open/listening on a host
# Usage: port_check <host> <port>
# Example: port_check localhost 8080
port_check() {
  local host="${1:-localhost}"
  local port="${2:?Usage: port_check <host> <port>}"

  if ! command -v nc &>/dev/null && ! command -v netcat &>/dev/null; then
    echo "❌ Error: netcat (nc) not found. Install with: brew install netcat" >&2
    return 1
  fi

  # Try with nc (GNU or BSD netcat)
  if nc -z -v "$host" "$port" 2>&1 | grep -q "succeeded"; then
    echo "✅ Port $port on $host is OPEN"
    return 0
  elif nc -z "$host" "$port" 2>/dev/null; then
    echo "✅ Port $port on $host is OPEN"
    return 0
  else
    echo "❌ Port $port on $host is CLOSED"
    return 1
  fi
}

# Check multiple ports at once
# Usage: port_check_many <host> <port1> [port2] [port3] ...
# Example: port_check_many localhost 80 443 8080
port_check_many() {
  local host="${1:?Usage: port_check_many <host> <port1> [port2] ...}"
  shift
  local ports=("$@")

  if [ ${#ports[@]} -eq 0 ]; then
    echo "❌ Error: No ports specified" >&2
    return 1
  fi

  echo "🔍 Checking ports on $host..."
  echo ""

  for port in "${ports[@]}"; do
    port_check "$host" "$port"
  done
}

# DNS lookup helpers
# Usage: dns_lookup <domain>
# Example: dns_lookup example.com
dns_lookup() {
  local domain="${1:?Usage: dns_lookup <domain>}"

  echo "🔍 DNS records for $domain:"
  echo ""

  # A record (IPv4)
  echo "📍 A Records (IPv4):"
  if dig +short -t A "$domain" 2>/dev/null | head -1; then
    dig +short -t A "$domain"
  else
    echo "  No A records found"
  fi
  echo ""

  # AAAA record (IPv6)
  echo "📍 AAAA Records (IPv6):"
  if dig +short -t AAAA "$domain" 2>/dev/null | head -1; then
    dig +short -t AAAA "$domain"
  else
    echo "  No AAAA records found"
  fi
  echo ""

  # MX records
  echo "📧 MX Records:"
  if dig +short -t MX "$domain" 2>/dev/null | head -1; then
    dig +short -t MX "$domain"
  else
    echo "  No MX records found"
  fi
  echo ""

  # CNAME records
  echo "🔗 CNAME Records:"
  if dig +short -t CNAME "$domain" 2>/dev/null | head -1; then
    dig +short -t CNAME "$domain"
  else
    echo "  No CNAME records found"
  fi
}

# Quick DNS check - show all records
# Usage: dns_all <domain>
# Example: dns_all example.com
dns_all() {
  local domain="${1:?Usage: dns_all <domain>}"

  if ! command -v dig &>/dev/null; then
    echo "❌ Error: dig not found. Install with: brew install bind" >&2
    return 1
  fi

  echo "📋 All DNS records for $domain:"
  echo ""
  dig "$domain" +noall +answer
}

# Check if a host is reachable
# Usage: host_check <host>
# Example: host_check google.com
host_check() {
  local host="${1:?Usage: host_check <host>}"

  echo "🏓 Pinging $host..."

  if ping -c 1 -W 1 "$host" >/dev/null 2>&1; then
    echo "✅ $host is reachable"

    # Show resolved IP
    local ip=$(dig +short "$host" 2>/dev/null | head -1)
    if [ -n "$ip" ]; then
      echo "   IP: $ip"
    fi

    return 0
  else
    echo "❌ $host is not reachable"
    return 1
  fi
}

