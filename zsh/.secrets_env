# ============================================
# Secure Credential Management
# ============================================
#
# This file contains credential loading functions using KeePassXC.
# It's sourced early in .zshrc to make credentials available to other functions.
#
# Note: Each keepassxc-cli call prompts for password because it doesn't share
# the GUI's unlocked session. To reduce prompts, keep KeePassXC GUI open.
# ============================================

load_secrets() {
  local keepass_db=~/Keepass/Sentry.kdbx
  
  # Check if KeePassXC CLI exists
  if ! command -v keepassxc-cli &>/dev/null; then
    echo "❌ Error: keepassxc-cli not found. Please install KeePassXC." >&2
    return 1
  fi
  
  # Check if database exists
  if [ ! -f "$keepass_db" ]; then
    echo "❌ Error: KeePassXC database not found at: $keepass_db" >&2
    return 1
  fi
  
  echo "🔐 Loading secrets from KeePassXC..."
  
  # Note: Each keepassxc-cli call requires a password because it doesn't share
  # the GUI's unlocked session. Consider using keepassxc-cli interactive mode
  # or unlock the database via CLI session to avoid repeated prompts:
  # 
  # Example: keepassxc-cli open ~/Keepass/Sentry.kdbx
  #          keepassxc-cli show -a OPENAI_API_KEY ~/Keepass/Sentry.kdbx 'auth0.openai.com'
  #          keepassxc-cli close
  #
  # Alternatively, use a key file: keepassxc-cli show -k ~/path/to/keyfile ...
  
  export OPENAI_API_KEY="$(keepassxc-cli show -a OPENAI_API_KEY "$keepass_db" 'auth0.openai.com' 2>/dev/null)"
  if [ $? -ne 0 ] || [ -z "$OPENAI_API_KEY" ]; then
    echo "⚠️  Warning: Failed to retrieve OPENAI_API_KEY" >&2
  fi

  export N8N_API_KEY="$(keepassxc-cli show -a N8N_API_KEY "$keepass_db" 'n8n Docker API Key' 2>/dev/null)"
  if [ $? -ne 0 ] || [ -z "$N8N_API_KEY" ]; then
    echo "⚠️  Warning: Failed to retrieve N8N_API_KEY" >&2
  fi
  
  echo "✅ Secrets loaded."
  # Add more secrets as needed
}
