# Activate python virtual environments
alias activate="source env/bin/activate"

# Start tmux session
alias tmux="tmux -u"

# Query tldr, integrate with fzf
alias tldrf='tldr --list | fzf --preview "tldr {1} --color=always" --preview-window=right,70% | xargs tldr'

# Git status
alias gs='git status'

if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    # For Ubuntu
    alias ls='exa --long --icons'
elif [[ "$OSTYPE" == "darwin"* ]]; then
    # Mac
    alias ls='lsd --long'
    alias keepassxc-cli='/Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli'
fi

# Git pre-push check
alias git-prepushcheck='
echo "🧭 Current branch:" && \
git branch --show-current && \
echo "\n🔍 Commits to be pushed:" && \
git log origin/$(git branch --show-current)..HEAD --oneline || echo "(No new commits)" && \
echo "\n🧱 Files changed vs remote:" && \
git diff --stat origin/$(git branch --show-current) && \
echo "\n🧪 Push dry run:" && \
git push --dry-run
'

# Openshift ROSA
alias kcshow='echo "Current kubeconfig: ${KUBECONFIG:-$HOME/.kube/config}" && echo "Current Context: $(oc config current-context)" && echo "User: $(oc whoami)"'
alias kcreset='export KUBECONFIG=$HOME/.kube/config && echo "🔄 Reset to default kubeconfig" && oc whoami'

# fabric-ai
alias fabric='fabric-ai'

# Use headroom with coding agents
alias claude='headroom wrap claude --'
alias codex='headroom wrap codex --'
alias opencode='headroom wrap opencode --'
